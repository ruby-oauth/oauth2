### rspec_junit_formatter
# Bucket boundaries follow Kettle::Rb::RubySeriesBuckets: r3.2 ends at 3.2.
version = Gem::Version.new(RUBY_VERSION)
if version >= Gem::Version.new("4.0")
  eval_gemfile "rspec_junit_formatter/r4/v0.8.gemfile"
elsif version >= Gem::Version.new("3.3")
  eval_gemfile "rspec_junit_formatter/r3/v0.8.gemfile"
elsif version >= Gem::Version.new("3.0")
  eval_gemfile "rspec_junit_formatter/r3.2/v0.6.gemfile"
else
  eval_gemfile "rspec_junit_formatter/r2/v0.6.gemfile"
end
