# frozen_string_literal: true

# To retain during kettle-jem templating:
#     kettle-jem:freeze
#     # ... your code
#     kettle-jem:unfreeze
#

# Style tasks run on the latest Ruby; RuboCop-LTS selects the compatibility
# rules for the configured Ruby floor independently from task dependency floors.

gem "reek", "~> 6.6", ">= 6.6.0"

platform :mri do
  gem "appraisal2-rubocop", "~> 1.0", ">= 1.0.5", require: false
  gem "rubocop-gradual", "~> 0.4", ">= 0.4.0"
  gem "rubocop-minitest", "~> 0.41", ">= 0.41.0"
  if Gem::Version.new(RUBY_VERSION) >= Gem::Version.new("3.3.0")
    gem "rubocop-on-rbs", "~> 2.2", ">= 2.2.0"      # ruby >= 3.3.0
  end
  # gem "rubocop", "~> 1.73", ">= 1.73.2" # constrained by standard
  gem "standard", "~> 1.57", ">= 1.57.0"

  if ENV.fetch("RUBOCOP_LTS_DEV", "false").casecmp("false").zero?
    gem "rubocop-packaging",
      github: "pboling/rubocop-packaging",
      ref: "3539ba858d379740d638566faee9e56b2b854145"
    declared_gems = instance_variable_get(:@dependencies).to_a.map(&:name)
    gem "rubocop-lts", "~> 8.3", ">= 8.3.3" unless declared_gems.include?("rubocop-lts")
    gem "rubocop-lts-rspec", "~> 1.0", ">= 1.0.8" unless declared_gems.include?("rubocop-lts-rspec")
    gem "rubocop-ruby2_2", "~> 3.0", ">= 3.0.7" unless declared_gems.include?("rubocop-ruby2_2")
  else
    eval_gemfile("style_local.gemfile")
  end
end
