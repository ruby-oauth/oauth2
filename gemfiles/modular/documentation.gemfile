# frozen_string_literal: true

# To retain during kettle-jem templating:
#     kettle-jem:freeze
#     # ... your code
#     kettle-jem:unfreeze
#

# Documentation
gem "kramdown", "~> 2.6", ">= 2.6.1", :require => false # Ruby >= 2.5
gem "kramdown-parser-gfm", "~> 1.1", :require => false # Ruby >= 2.3
gem "yaml-converter", "~> 0.2", ">= 0.2.8", :require => false # Ruby >= 3.2
gem "yard", "~> 0.9", ">= 0.9.46", :require => false
gem "yard-junk", "~> 0.1", ">= 0.1.0", :require => false # Ruby >= 3.1
gem "yard-lint", "~> 1.15", ">= 1.15.0", :require => false # Ruby >= 3.3
gem "yard-relative_markdown_links", "~> 0.6", :require => false

if ENV.fetch("GALTZO_FLOSS_DEV", "false").casecmp("false").zero?
  gem "yard-fence", "~> 0.9", ">= 0.9.12", :require => false # Ruby >= 3.2
  gem "yard-timekeeper", "~> 0.2", ">= 0.2.11", :require => false
  gem "yard-yaml", "~> 0.2", ">= 0.2.6", :require => false
else
  eval_gemfile "documentation_local.gemfile"
end
