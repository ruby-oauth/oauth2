#!/bin/sh

# Fail on error and unset variables
set -eu

# Resolve the installed gem executable through RubyGems, not a repository-local
# Bundler binstub that may select a temporarily inconsistent project lockfile.
exec env RUBYOPT= ruby -e 'require "rubygems"; load Gem.bin_path("kettle-dev", "kettle-commit-msg")' "$@"
